meta {
  name: Health
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

tests {
  test("returns healthy status", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("ok");
  });
}
